---
import Section from "../Section.astro";

import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import { education } from "@cv";
import { certificates } from "@cv";

// cv.json points badges at /public paths; import them so they get resized (80px + 2x) like the avatar
const publicImages = import.meta.glob<{ default: ImageMetadata }>("/public/*.{avif,webp,png,jpg,jpeg}", { eager: true });
---

<Section className={Astro.props.className} title="Education">
	<ul class="space-y-4 py-3 print:space-y-0 print:py-0" data-reveal-stagger>
		{
			education.map(({ institution, startDate, endDate, area, studyType, score, url }) => {
				const formatDate = (date: string) => new Date(date).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
				const startFormatted = formatDate(startDate);
				const endFormatted = endDate != null ? formatDate(endDate) : "Present";
				const years = `${startFormatted} - ${endFormatted}`;

				return (
					<li>
						<div class="flex items-baseline">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="24"
								height="24"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="mr-2 hidden h-5 w-5 self-start md:inline-block print:hidden"
							>
								<path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z" />
								<path d="M22 10v6" />
								<path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5" />
							</svg>
							<div class="relative w-full items-baseline justify-between gap-2 print:flex print:flex-col print:gap-0">
								<div class="print:flex print:w-full print:items-baseline print:justify-between">
									<h3 class="mr-6 items-baseline gap-x-2 gap-y-0.5 font-medium print:mr-0 print:shrink-0 print:text-[10pt] print:font-medium print:text-ink">
										<a
											target="_blank"
											class="hover:text-skin-link group flex items-center gap-1.5 decoration-dotted underline-offset-[5px] hover:underline"
											href={url}
										>
											{studyType ? `${studyType} in ${area}` : area}
										</a>
									</h3>
									<time class="text-skin-muted block text-xs print:static print:ml-auto print:shrink-0 print:text-[8pt] print:italic print:text-muted">
										{years}
									</time>
								</div>
								<div class="print:flex print:w-full print:items-baseline print:justify-between">
									<div class="text-skin-muted text-sm print:text-[8.5pt] print:italic print:text-primary-active">
										{institution}
									</div>
									{score && <span class="hidden print:inline print:ml-auto print:text-[8pt] print:text-body">CGPA: {score}</span>}
								</div>
							</div>
						</div>
					</li>
				);
			})
		}
	</ul>

	{
		certificates.length > 0 && (
			<>
				<h3 data-reveal="rise" class="display relative flex w-full items-center gap-3 pt-4 pb-2 text-4xl print:gap-1 print:pt-0 print:pb-1 print:text-[16pt] print:font-medium print:text-body print:border-b print:border-hairline print:mt-2">Certificates</h3>
				<ul class="flex flex-wrap gap-3 print:hidden" data-reveal-stagger="scale">
					{certificates
						.filter(({ image }) => image)
						.map(({ name, image, url }) => {
							const source = publicImages[`/public${image}`]?.default;
							const badge = source ? (
								<Image src={source} alt={name} title={name} width={80} height={80} densities={[1, 2]} format="avif" loading="lazy" class="h-20 w-20" />
							) : (
								<img src={image} alt={name} title={name} width="80" height="80" loading="lazy" class="h-20 w-20" />
							);
							return (
								<li>
									{url ? (
										<a href={url} target="_blank" class="block transition-transform hover:scale-105" data-tilt="18">
											{badge}
										</a>
									) : (
										badge
									)}
								</li>
							);
						})}
				</ul>
				<ul class="space-y-4 py-3 print:space-y-0 print:py-0" data-reveal-stagger>
					{certificates.map(({ name, date, issuer, url, image }) => {
						const certificateYear = date && new Date(date).getFullYear();
						return (
							<li class:list={{ "hidden print:list-item": image }}>
								<div class="flex items-baseline">
									<svg
										xmlns="http://www.w3.org/2000/svg"
										width="24"
										height="24"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										class="mr-2 hidden h-5 w-5 self-start md:inline-block print:hidden"
									>
										<path d="M15 12h-5" />
										<path d="M15 8h-5" />
										<path d="M19 17V5a2 2 0 0 0-2-2H4" />
										<path d="M8 21h12a2 2 0 0 0 2-2v-1a1 1 0 0 0-1-1H11a1 1 0 0 0-1 1v1a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v2a1 1 0 0 0 1 1h3" />
									</svg>
									<div class="relative w-full items-baseline justify-between gap-2 print:flex print:items-baseline print:gap-2">
										<h3 class="mr-6 items-baseline gap-x-2 gap-y-0.5 font-medium print:mr-0 print:shrink-0 print:text-[10pt] print:font-normal print:text-body">
											<a
												class="hover:text-skin-link group text-skin-base flex items-center gap-1.5 decoration-dotted underline-offset-[5px] hover:underline"
												href={url}
												target="_blank"
											>
												{name}
											</a>
										</h3>
										<div class="text-skin-muted text-sm print:text-[8pt] print:italic print:text-primary-active">
											{issuer}
										</div>
										{certificateYear && (
											<time class="text-skin-muted block text-xs print:static print:ml-auto print:shrink-0 print:text-[8pt]">
												{certificateYear}
											</time>
										)}
									</div>
								</div>
							</li>
						);
					})}
				</ul>
			</>
		)
	}
</Section>
