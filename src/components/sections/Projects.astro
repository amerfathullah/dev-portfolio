---
import Git from "@/icons/git.astro";
import Arrow from "@/icons/Arrow.astro";
import Section from "../Section.astro";
import Collapsible from "../Collapsible.astro";

import { projects } from "@cv";
---

<Section className={Astro.props.className} title="Projects">
	{/* Uniform 26rem cards: fits the typical project (title, summary, 2–3 highlights); longer ones collapse.
	    Two columns only from lg — at md the column is too narrow and cards would mostly be clipped.
	    items-start keeps a row-mate at 26rem when its neighbour expands. */}
	<div class="grid items-start gap-3 lg:grid-cols-2 print:block print:space-y-1">
		{
			projects.map(({ url, description, highlights, name, isActive, github }) => {
				return (
					<Collapsible mode="fixed" height="26rem" label={name} role="contentinfo" data-reveal="" class="spotlight relative break-inside-avoid print:break-inside-auto rounded-xl bg-skin-button-muted p-8 print:rounded-none print:bg-transparent print:p-0">
						<div slot="header" class="flex items-center justify-between space-x-2.5">
							<div class="flex items-center gap-2">
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-folder size-4 print:hidden">
									<path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" />
								</svg>
								<div class="flex items-center gap-1.5">
									{isActive && url ? (
										<a class="hover:text-skin-hue group flex items-center gap-1.5 text-lg font-medium decoration-dotted underline-offset-[5px] hover:underline print:text-[10pt] print:font-medium print:text-ink" href={url} title={`Ver ${name}`} target="_blank">
											{name}
											<span class="text-skin-hue transition ease-linear group-hover:-translate-y-0.5 group-hover:translate-x-0.5 print:hidden">
												<Arrow />
											</span>
										</a>
									) : (
										<span class="text-lg font-medium print:text-[10pt] print:font-medium print:text-ink">{name}</span>
									)}
								</div>
							</div>

							{github && (
								<a href={github} title="View slug repository on GitHub" target="_blank" rel="noopener" class="opacity-75 transition-opacity duration-100 hover:opacity-100 print:hidden">
									<Git />
								</a>
							)}
						</div>

						<p class="print-accent py-3 text-base text-skin-base print:py-0 print:text-[8.5pt]">{description}</p>
						<ul class="print-bullets mt-1 text-sm text-skin-muted print:mt-0 print:text-[8.5pt] print:text-body">
							{highlights.map((highlight) => {
								return <li>{highlight}</li>;
							})}
						</ul>
					</Collapsible>
				);
			})
		}
	</div>
</Section>

<style>
	@reference "@/styles/global.css";
	ul {
		@apply ml-4 list-disc space-y-1;
		li {
			@apply text-skin-muted;
		}
	}

	@keyframes flicker {
		0% {
			opacity: 1;
		}
		50% {
			opacity: 0.25;
		}
		100% {
			opacity: 1;
		}
	}
</style>
