---
import { basics } from "@cv";
import Section from "@/components/Section.astro";
import Mail from "@/icons/Mail.astro";
import Phone from "@/icons/Phone.astro";
import X from "@/icons/X.astro";
import LinkedIn from "@/icons/LinkedIn.astro";
import GitHub from "@/icons/GitHub.astro";
import WorldMap from "@/icons/WorldMap.astro";
import type { SocialIcon } from "@/types";
import sharp from "sharp";
import { fileURLToPath } from "node:url";

// The avatar is the LCP element. Inline it (256px AVIF, ~5 KB: sharp at 2x of the 128px
// box) so it paints with the HTML instead of waiting on a request that competes with fonts.
const avatarPath = fileURLToPath(new URL("../../../public/me_avatar.avif", import.meta.url));
const avatar = await sharp(avatarPath).resize(256, 256).avif({ quality: 50 }).toBuffer();
const avatarSrc = `data:image/avif;base64,${avatar.toString("base64")}`;

const { name, label, location, profiles, phone, email } = basics;
const { city, region } = location;

const SOCIAL_ICONS: SocialIcon = {
	GitHub,
	LinkedIn,
	X,
};

const linkedInfo = profiles.find(({ network }) => network === "LinkedIn");
const linkedUrl = linkedInfo?.url;

const githubInfo = profiles.find(({ network }) => network === "GitHub");
const githubUrl = githubInfo?.url;

const printInfo = [email, phone, linkedUrl, githubUrl].filter(Boolean).join(" • ");
---

<Section>
	<div class="flex flex-col-reverse gap-8 print:flex-col print:items-center print:gap-0 print:text-center">
		<div class="info print:flex print:flex-col print:items-center">
			<h1 class="display">
				{
					name.split(" ").map((word, i) => (
						<>
							<span class="hero-word" style={`--i: ${i}`}>
								<span>{word}</span>
							</span>{" "}
						</>
					))
				}
			</h1>
			<h2>{label}</h2>
			<div class="hero-location text-skin-muted flex items-center gap-2 pt-2 text-sm print:hidden">
				<WorldMap />
				{city}, {region}
			</div>
			<footer class="print print:mt-1 print:text-[8pt] print:text-body">
				{printInfo}
			</footer>
			<footer class="no-print" data-magnetic>
				{
					email && (
						<div class="relative flex items-center">
							<a
								href={`mailto:${email}`}
								class="cursor-pointer"
								title={`Send email to ${email}`}
								aria-label={`Send email to ${name}`}
							>
								<Mail />
							</a>
						</div>
					)
				}
				{
					phone && (
						<a
							href={`tel:${phone}`}
							title={`Call ${name} at ${phone}`}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={`Call ${name}`}
						>
							<Phone />
						</a>
					)
				}
				{
					profiles.map(({ network, url }) => {
						const Icon = SOCIAL_ICONS[network];

						return (
							<a
								href={url}
								title={`Visit ${name} profile on ${network}`}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={`Visit ${name} on ${network}`}
							>
								<Icon />
							</a>
						);
					})
				}
				<div
					class="no-print footer-button icon-button cursor-pointer max-sm:hidden"
					role="button"
					tabindex="0"
					aria-label="Open keyboard shortcuts"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						class="icon icon-tabler icon-tabler-command h-5 w-5"
						viewBox="0 0 24 24"
						stroke-width="1.5"
						stroke="currentColor"
						fill="none"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path stroke="none" d="M0 0h24v24H0z" fill="none"
						></path>
						<path
							d="M7 9a2 2 0 1 1 2 -2v10a2 2 0 1 1 -2 -2h10a2 2 0 1 1 -2 2v-10a2 2 0 1 1 2 2h-10"
						></path>
					</svg>
				</div>
			</footer>
		</div>
		<figure class="relative w-fit print:hidden" data-tilt="12">
			<img src={avatarSrc} alt={name} width="128" height="128" />
			<div class="pointer-events-none absolute -inset-2">
				<div
					class="hero-line hero-line-y bg-skin-fill-muted absolute -inset-y-8 right-0 w-px mask-[linear-gradient(to_top,transparent,white_4rem,white_calc(100%-4rem),transparent)]"
				>
				</div>
				<div
					class="hero-line hero-line-y bg-skin-fill-muted absolute -inset-y-8 left-0 w-px mask-[linear-gradient(to_top,transparent,white_4rem,white_calc(100%-4rem),transparent)]"
				>
				</div>
				<div
					class="hero-line hero-line-x bg-skin-fill-muted absolute -inset-x-8 bottom-0 h-px mask-[linear-gradient(to_left,transparent,white_4rem,white_calc(100%-4rem),transparent)]"
				>
				</div>
				<div
					class="hero-line hero-line-x bg-skin-fill-muted absolute -inset-x-8 top-0 h-px mask-[linear-gradient(to_left,transparent,white_4rem,white_calc(100%-4rem),transparent)]"
				>
				</div>
			</div>
		</figure>
	</div>
</Section>

<style>
	@reference "@/styles/global.css";
	.info {
		@apply flex flex-col gap-1 pr-8 print:gap-0 print:pr-0;
	}

	/* display-lg: serif name */
	h1 {
		@apply text-5xl leading-[1.05] print:text-3xl;
	}

	/* sub-headline: body-md in muted */
	h2 {
		@apply text-skin-muted text-base font-normal text-balance print:text-lg print:font-medium;
	}

	img {
		@apply aspect-square w-32 rounded-2xl bg-cover;
	}

	span {
		@apply text-skin-hue flex items-center gap-1 text-xs;
	}

	footer {
		@apply mt-4 flex gap-2 text-sm;
	}

	/* button-icon-circular */
	footer a,
	footer button {
		@apply border-skin-fill-muted bg-skin-fill text-skin-base hover:bg-skin-button-muted inline-flex size-9 items-center justify-center rounded-full border p-2 transition-colors;
	}

	@media (width <= 700px) {
		.container {
			flex-direction: column-reverse;
		}

		.info {
			@apply pr-0 md:items-center md:justify-center;
		}

		figure {
			@apply flex md:items-center md:justify-center;
		}

		h2 {
			text-wrap: balance;
		}

		figure {
			@apply md:mx-auto;
		}
	}

	/* The name's word spans must not pick up the generic span style above */
	.hero-word,
	.hero-word > span {
		display: inline;
		font-size: inherit;
		color: inherit;
	}

	/* ── Entrance: avatar wipes in, crop marks draw, name rises word by word, then the rest ── */
	/* The name is the LCP element: it must be painted (visible, unclipped) from the first frame,
	   so words rise and sharpen in place rather than sliding out from behind a mask. */
	@keyframes hero-word-in {
		from {
			transform: translateY(0.3em) rotate(3deg);
			filter: blur(6px);
		}
	}
	@keyframes hero-fade-up {
		from {
			opacity: 0;
			transform: translateY(0.75rem);
			filter: blur(4px);
		}
	}
	@keyframes hero-pop {
		from {
			opacity: 0;
			transform: translateY(0.5rem) scale(0.6);
		}
	}
	@keyframes hero-avatar-in {
		from {
			clip-path: inset(100% 0 0 0 round 1rem);
			transform: scale(1.12);
		}
		to {
			clip-path: inset(0 0 0 0 round 1rem);
		}
	}
	@keyframes hero-line-y {
		from {
			transform: scaleY(0);
		}
	}
	@keyframes hero-line-x {
		from {
			transform: scaleX(0);
		}
	}

	@media screen and (prefers-reduced-motion: no-preference) {
		:global(html.motion) .hero-word > span {
			display: inline-block;
			transform-origin: 0 100%;
			animation: hero-word-in 1100ms var(--ease-out-expo) backwards;
			animation-delay: calc(100ms + var(--i) * 120ms);
		}
		:global(html.motion) h2 {
			animation: hero-fade-up 900ms var(--ease-out-expo) 650ms backwards;
		}
		:global(html.motion) .hero-location {
			animation: hero-fade-up 900ms var(--ease-out-expo) 750ms backwards;
		}
		:global(html.motion) footer.no-print > * {
			animation: hero-pop 700ms var(--ease-spring) backwards;
			animation-delay: calc(850ms + var(--n, 0) * 60ms);
		}
		footer.no-print > :nth-child(2) { --n: 1; }
		footer.no-print > :nth-child(3) { --n: 2; }
		footer.no-print > :nth-child(4) { --n: 3; }
		footer.no-print > :nth-child(5) { --n: 4; }
		footer.no-print > :nth-child(6) { --n: 5; }
		footer.no-print > :nth-child(7) { --n: 6; }
		footer.no-print > :nth-child(8) { --n: 7; }

		:global(html.motion) figure :global(img) {
			animation: hero-avatar-in 1200ms var(--ease-out-expo) 100ms backwards;
		}
		:global(html.motion) .hero-line-y {
			animation: hero-line-y 1400ms var(--ease-out-expo) 200ms backwards;
		}
		:global(html.motion) .hero-line-x {
			animation: hero-line-x 1400ms var(--ease-out-expo) 300ms backwards;
		}
	}
</style>
