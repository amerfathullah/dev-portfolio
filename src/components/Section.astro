---
const { className, title } = Astro.props;
const sectionId = title ? title.toLowerCase().replace(/\s+/g, "-") : undefined;
---

<section
	class:list={["flex flex-col gap-4 print:gap-1 print:mt-2", className]}
	aria-labelledby={sectionId}
>
	{
		title && (
			<h3
				id={sectionId}
				data-reveal="rise"
				class="display relative flex w-full items-center gap-3 pb-2 text-4xl print:gap-1 print:pb-1 print:text-[16pt] print:font-medium print:text-body print:border-b print:border-hairline"
			>
				{title}
			</h3>
		)
	}
	<slot />
</section>
