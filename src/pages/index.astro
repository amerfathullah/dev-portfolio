---
import Layout from "@/layouts/Layout.astro";

import About from "@/components/sections/About.astro";
import Education from "@/components/sections/Education.astro";
import Experience from "@/components/sections/Experience.astro";
import Hero from "@/components/sections/Hero.astro";
import Projects from "@/components/sections/Projects.astro";
import Skills from "@/components/sections/Skills.astro";
import Tail from "@/components/sections/Tail.astro";
import KoFi from "@/components/sections/KoFi.astro";
import KeyboardManager from "@/components/KeyboardManager.astro";
import ThemeSwitch from "@/components/ThemeSwitch.astro";

import { basics } from "@cv";
const { name, label } = basics;
---

<Layout title={`${name} Portfolio - ${label}`}>
	<!--
		Screen: sidebar (profile, summary, education) + wide column (experience, projects),
		then a full-width Skills band.
		Phone (single column) and print: both column wrappers become display:contents so the
		sections join one grid, and order-* restores Hero → Summary → Experience → Projects → Skills → Education.
	-->
	<main class="relative grid max-w-7xl gap-12 p-8 max-sm:py-16 md:grid-cols-6 md:p-16 xl:gap-24 print:max-w-none print:grid-cols-1 print:gap-1 print:p-0">
		<div class="space-y-12 max-md:contents md:col-span-2 print:contents">
			<div class="space-y-6 print:contents">
				<Hero />
				<About />
			</div>
			<Education className="max-md:order-4 print:order-4" />
			<div class="space-y-6 print:contents">
				<KoFi />
				<ThemeSwitch />
			</div>
		</div>
		<div class="space-y-12 max-md:contents md:col-span-4 print:contents">
			<Experience className="max-md:order-1 print:order-1" />
			<Projects className="max-md:order-2 print:order-2" />
		</div>
		<Skills className="max-md:order-3 md:col-span-6 print:order-3" />
		<div class="max-md:order-last md:col-span-6 print:hidden">
			<Tail />
		</div>
	</main>

	<KeyboardManager />
</Layout>

<style>
	@page {
		size: A4;
		margin: 0.8cm 1.4cm 1.8cm 1.4cm;
	}
	main {
		margin: auto;
		width: 100%;
	}
</style>
